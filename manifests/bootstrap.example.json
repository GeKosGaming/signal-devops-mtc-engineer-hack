    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "signal-storage-init",
        "labels": {
          "app.kubernetes.io/name": "signal-storage-init",
          "app.kubernetes.io/part-of": "signal"
        },
        "namespace": "signal-system"
      },
      "spec": {
        "backoffLimit": 1,
        "activeDeadlineSeconds": 120,
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "storage-init",
              "app.kubernetes.io/part-of": "signal"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "restartPolicy": "Never",
            "nodeSelector": {
              "kubernetes.io/hostname": "signal-node"
            },
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "prepare",
                "image": "docker.io/library/busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e",
                "imagePullPolicy": "IfNotPresent",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ],
                    "add": [
                      "CHOWN",
                      "FOWNER",
                      "DAC_OVERRIDE"
                    ]
                  },
                  "runAsUser": 0,
                  "runAsNonRoot": false
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "16Mi"
                  },
                  "limits": {
                    "cpu": "1000m",
                    "memory": "64Mi"
                  }
                },
                "args": [
                  "sh",
                  "-ec",
                  "mkdir -p /data/prometheus && chmod 700 /data/prometheus && chown 65534:65534 /data/prometheus && mkdir -p /data/loki && chmod 700 /data/loki && chown 10001:10001 /data/loki && mkdir -p /data/grafana && chmod 700 /data/grafana && chown 472:472 /data/grafana && mkdir -p /data/alertmanager && chmod 700 /data/alertmanager && chown 65534:65534 /data/alertmanager"
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/data",
                    "readOnly": false
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "hostPath": {
                  "path": "/var/lib/signal-storage",
                  "type": "DirectoryOrCreate"
                }
              }
            ]
          }
        }
